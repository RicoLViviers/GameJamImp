@export var randomStrength: float = 30.0
@export var shakeFade: float = 5.0

var rng = RandomNumberGenerator.new()

var shake_strength: float = 0.0


func _ready() -> void:
	pass

func apply_shake():
		shake_strength = randomStrength
		
func randomOffset() -> Vector2:
	return Vector2(rng)
	
"

